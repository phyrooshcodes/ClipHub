# Obscura Clips Environment Settings
# Rename this file to '.env' and enter your NVIDIA NIM API Key below.
# Get a free key with credits at: https://build.nvidia.com/

NVIDIA_API_KEY=nvapi-YOUR_API_KEY_HERE

# Personal Instagram Playwright uploader (no Meta app or API token required).
# Set to 0 if Instagram is more reliable on your machine with a visible browser.
OBSCURA_INSTAGRAM_HEADLESS=1
# Optional: override the OS-private state directory that stores browser cookies,
# SQLite upload history, and failure diagnostics. Never point this inside the repo.
# XDG_STATE_HOME=/absolute/private/state-directory
